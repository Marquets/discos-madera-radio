# Id de la playlist colaborativa: open.spotify.com/playlist/<ESTO>
SPOTIFY_PLAYLIST_ID=

# Opcional: enlace de invitación (Spotify → ··· → Invitar colaboradores). Con él, el
# enlace Playlist del menú deja añadir canciones; sin él solo deja escucharla
SPOTIFY_PLAYLIST_INVITE_URL=

# Opcional: la cadena de Navidad (lib/cadenas.ts). Con la playlist puesta sale un botón en la
# cabecera para cambiar de cadena, y del 1 de diciembre al 6 de enero es la que suena por
# defecto. Sus canciones se guardan aparte (clave db-navidad en Blobs, data/db-navidad.json en
# local), así que el archivo de siempre no se toca
SPOTIFY_PLAYLIST_ID_NAVIDAD=
SPOTIFY_PLAYLIST_INVITE_URL_NAVIDAD=

# Opcional: Web API de Spotify (app en developer.spotify.com). Con las tres, el sync lee la
# playlist entera (sin el límite de 100), con la fecha real y quién añadió cada canción.
# El refresh token sale de iniciar sesión una vez con una cuenta que vea la playlist
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Opcional, solo si quieres forzar el sync desde un cron: GET /api/sync con
# Authorization: Bearer <este valor>
CRON_SECRET=

# Opcional: clave gratuita de la API de YouTube (Google Cloud). Con ella cada canción
# se busca en YouTube al sincronizar y en el móvil la radio suena por YouTube
YOUTUBE_API_KEY=

# Opcional: id de la playlist de YouTube con los directos de /live:
# youtube.com/playlist?list=<ESTO>. Necesita también YOUTUBE_API_KEY
YOUTUBE_LIVES_PLAYLIST_ID=
